# Порт, на котором сервис слушает запросы (внутри контейнера и на хосте).
# Меняйте, чтобы не конфликтовать с другими сервисами на сервере.
ENRICH_PORT=8000

# Уровень логирования (DEBUG|INFO|WARNING|ERROR)
ENRICH_LOG_LEVEL=INFO

# Таймаут (сек) и число повторов запросов к источникам
ENRICH_REQUEST_TIMEOUT=15
ENRICH_REQUEST_RETRIES=2

# Батч-обогащение: параллелизм и пауза между адресами (сек).
# dom.mos.ru за DDoS-Guard и блокирует при большом числе запросов,
# поэтому по умолчанию строго последовательно (1) с паузой 0.5с.
ENRICH_BATCH_CONCURRENCY=1
ENRICH_BATCH_DELAY=0.5

# Кэширование результатов (данные о домах меняются редко)
ENRICH_CACHE_ENABLED=true
# Время жизни записи кэша, секунды (по умолчанию 30 дней)
ENRICH_CACHE_TTL=2592000
# Адрес Redis (имя сервиса `redis` внутри docker-compose сети)
ENRICH_REDIS_URL=redis://redis:6379/0

# Путь к предварительно собранному индексу адресов ГИС ЖКХ (index.json).
# Если пусто, источник работает только при передаче ФИАС из другого источника.
ENRICH_GIS_ZHKH_INDEX_PATH=

# Проверка доступности домашнего интернета Beeline по ФИАС.
ENRICH_BEELINE_ENABLED=true
ENRICH_BEELINE_TIMEOUT=10
